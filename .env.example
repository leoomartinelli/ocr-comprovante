# Copie para .env e ajuste. O .env nunca vai para o git.

# --- Obrigatório -------------------------------------------------------------
# Chave que o n8n envia no header X-API-Key. Gere uma longa e aleatória:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=troque-por-uma-chave-longa

# --- Geral -------------------------------------------------------------------
TAMANHO_MAXIMO_MB=10
LOG_LEVEL=INFO

# --- OCR ---------------------------------------------------------------------
# Abaixo desta confiança (0 a 1) o resultado é considerado fraco: tenta reler ampliado
# e, se o fallback estiver ligado, chama o LLM.
CONFIANCA_MINIMA=0.75
# Prints mais estreitos que isso (px) são ampliados 2x antes do OCR.
LARGURA_MINIMA_ESCALA=800
# Quantos OCRs podem rodar ao mesmo tempo (cada um usa CPU).
OCR_CONCORRENCIA=2

# --- Cache por hash (só hash + resultado; o arquivo original nunca é gravado) ------
CACHE_ATIVO=true
CACHE_DB_PATH=dados/cache.db
CACHE_TTL_DIAS=30

# --- Fallback LLM (desligado por padrão; gasta dinheiro quando ligado) --------------
LLM_FALLBACK_ATIVO=false
ANTHROPIC_API_KEY=
LLM_MODELO=claude-haiku-4-5
LLM_MAX_CHARS=6000
LLM_TIMEOUT_SEGUNDOS=20
